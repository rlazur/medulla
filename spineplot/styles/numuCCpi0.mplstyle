# Heavily copied from DUNE, but with style preferences as needed/desired from Jaesung Kim, Bruce Howard, and Justin Mueller for ICARUS.
# see https://github.com/DUNE/dune_plot_style/blob/main/src/matplotlib/stylelib/dune.mplstyle

## FONT
font.sans-serif:  Helvetica, Helvetica Neue, Nimbus Sans, Liberation Sans, Arial

## FIGURE
figure.titlesize: 36
figure.constrained_layout.use: True
figure.facecolor: white

## AXES
axes.linewidth: 1.0
axes.labelsize: xx-large
axes.titlesize: 36
# adding an additional padding, tuned based on an example plot and giving room for the preliminary/POT labels, etc.
axes.titlepad: 28

## PATCHES
# DUNE claims histograms are patches
# Here we differ a bit from DUNE settings
patch.linewidth: 2.0

## TICKS
xtick.top: False
xtick.bottom: True
xtick.direction: in
xtick.minor.visible: True
xtick.major.size: 10
xtick.minor.size: 5
xtick.labelsize: medium

ytick.left: True
ytick.right: True
ytick.direction: in
ytick.minor.visible: True
ytick.major.size: 10
ytick.minor.size: 5
ytick.labelsize: medium

## GRID
grid.color: b2b2b2
grid.linestyle: --
grid.linewidth: 0.5

## LEGEND
legend.fontsize: 10.5
legend.frameon: False
# legend.loc: upper center

# Vertical compression
legend.labelspacing: 0.2      # Reduces the vertical space between entries (default is usually ~0.5)

# Horizontal compression
legend.handlelength: 1.1      # Reduces the width of the colored boxes/lines (default is usually ~2.0)
legend.handletextpad: 0.5     # Reduces the gap between the colored box and the text (default is ~0.8)
legend.columnspacing: 0.5     # Gap between columns (if ncols > 1)

# Overall padding (if you ever turn frameon back to True, or for edge spacing)
legend.borderpad: 0.2         # Reduces the internal whitespace around the legend items


## LINES
lines.linewidth: 2.0

## COLORS
#                                Greenish   Vermilion   Black     Blue      Orange  Purplish  Sky Blue  
axes.prop_cycle: cycler('color', ['009E73', 'D55E00', '000000', '0072B2', 'E69F00', 'CC79A7', '56B4E9', 'F0E442',])

# Cividis is Colo(u)r Vision Deficiency friendly
image.cmap: Blues

savefig.facecolor: white






